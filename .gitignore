# --- macOS / IDE ---
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# --- Python (uv) ---
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
