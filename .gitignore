# --- Terraform ---
# .terraform/ holds provider plugins (machine-specific, large).
# *.tfstate is sensitive (contains secrets in plaintext) and now lives in S3 anyway.
# .terraform.lock.hcl IS committed (provider version pin); do NOT add it here.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- LocalStack volume ---
.localstack/
volume/

# --- Eval reports (large, regenerable) ---
evals/reports/

*.md
!/README.md
